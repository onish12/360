; PHASER360 M0.6.15H15E-LIVE R0
; Exact-target Extension upper filter for transient read-only MMIO capture.
; No MMIO write, PCI write, DMA, DSP boot or playback.

[Version]
Signature="$WINDOWS NT$"
Class=Extension
ClassGuid={e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider=%ProviderName%
ExtensionId={53f678f1-2b3e-4b2e-a15e-360031980001}
CatalogFile=phaser360_h15e_live_filter.cat
PnpLockdown=1
DriverVer=09/22/2026,0.6.15.171

[DestinationDirs]
DefaultDestDir=13
H15eLive.CopyFiles=13

[SourceDisksNames]
1=%DiskDesc%,,,""

[SourceDisksFiles]
phaser360_h15e_live_filter.sys=1

[ControlFlags]
ExcludeFromSelect=*

[Manufacturer]
%ProviderName%=H15eLive.Models,NTamd64.10.0...19045,NTamd64.10.0...19044

[H15eLive.Models.NTamd64.10.0...19045]

[H15eLive.Models.NTamd64.10.0...19044]
%DeviceDesc%=H15eLive_Install,PCI\VEN_8086&DEV_3198&SUBSYS_00000000&REV_06

[H15eLive_Install.NT]
CopyFiles=H15eLive.CopyFiles

[H15eLive.CopyFiles]
phaser360_h15e_live_filter.sys

[H15eLive_Install.NT.Services]
AddService=Phaser360H15eLive,0x00000000,H15eLive_Service

[H15eLive_Service]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\phaser360_h15e_live_filter.sys

[H15eLive_Install.NT.Filters]
AddFilter=Phaser360H15eLive,,H15eLive_Filter

[H15eLive_Filter]
FilterPosition=Upper

[H15eLive_Install.NT.Wdf]
KmdfService=Phaser360H15eLive,H15eLive_Wdf

[H15eLive_Wdf]
KmdfLibraryVersion=1.31

[Strings]
ProviderName="PHASER360 Experimental"
DeviceDesc="PHASER360 H15E-LIVE Read-Only MMIO Snapshot Extension"
ServiceDesc="PHASER360 H15E-LIVE Read-Only MMIO Upper Filter"
DiskDesc="PHASER360 H15E-LIVE R0 Filter Package"
