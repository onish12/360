H15dLive.CopyFiles=13
[SourceDisksNames]
1=%DiskDesc%,,,""
[SourceDisksFiles]
phaser360_h15d_live_filter.sys=1
[ControlFlags]
ExcludeFromSelect=*
[Manufacturer]
%ProviderName%=H15dLive.Models,NTamd64.10.0...19045,NTamd64.10.0...19044
[H15dLive.Models.NTamd64.10.0...19045]
[H15dLive.Models.NTamd64.10.0...19044]
%DeviceDesc%=H15dLive_Install,PCI\VEN_8086&DEV_3198&SUBSYS_00000000&REV_06
[H15dLive_Install.NT]
CopyFiles=H15dLive.CopyFiles
[H15dLive.CopyFiles]
phaser360_h15d_live_filter.sys
[H15dLive_Install.NT.Services]
AddService=Phaser360H15dLive,0x00000000,H15dLive_Service
[H15dLive_Service]
