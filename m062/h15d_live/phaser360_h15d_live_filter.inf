; PHASER360 M0.6.15H15D-LIVE R1 - manual bounded transaction only
[Version]
Signature="$WINDOWS NT$"
Class=Extension
ClassGuid={e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider=%ProviderName%
ExtensionId={53f678f1-2b3c-4b2e-a15d-360031980001}
CatalogFile=phaser360_h15d_live_filter.cat
PnpLockdown=1
DriverVer=09/22/2026,0.6.15.161

[DestinationDirs]
